<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Premium Dark -->
    <style name="Theme.PlayStream" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/primary_light</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/surface_elevated</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="colorOutlineVariant">@color/surface_elevated</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Force dark mode -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.PlayStream.FullScreen" parent="Theme.PlayStream">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Custom Toolbar Style -->
    <style name="PlayStream.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/PlayStream.ToolbarTitle</item>
    </style>

    <style name="PlayStream.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_light</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>